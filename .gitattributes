# Never let git touch driver binaries: .cat catalogs contain hashes of the
# .inf/.sys files, so any line-ending or encoding rewrite silently breaks
# driver signature validation.
*.sys   binary
*.cat   binary
*.inf   binary
*.bin   binary
*.i64   binary
*.ri    binary
*.aiqb  binary
*.cpf   binary
*.cer   binary
*.exe   binary
*.dll   binary
*.ico   binary
*.rtf   binary

* text=auto
.gitattributes text eol=lf
*.svg     text eol=lf
*.md      text eol=lf
*.py      text eol=lf
*.list    text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.iss     text eol=crlf
*.yml     text eol=lf
LICENSE   text eol=lf
*.ps1     text eol=crlf
*.c       text
*.h       text
*.vcxproj text
*.sln     text
