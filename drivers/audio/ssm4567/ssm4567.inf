;/*++
;
;Copyright (c) CoolStar.  All rights reserved.
;
;Module Name:
;    ssm4567.inf
;
;Abstract:
;    INF file for installing the Analog Devices SSM4567 Driver
;
;    Target: HP Chromebook 13 G1 (CHELL) - ACPI\INT343B\0 / \1 on I2C4
;             (addr 0x34 left, 0x35 right per coreboot overridetree.cb)
;
;    NOTE: the ssm4567.sys next to this INF is signed by
;    "Microsoft Windows Hardware Compatibility Publisher" (WHQL).
;    Windows still requires a catalog for the *package*, so the cat is
;    generated by Inf2Cat and signed by make-cat.ps1.
;
;--*/

[Version]
Signature   = "$WINDOWS NT$"
Class       = Media
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = CoolStar
DriverVer   = 11/8/2026,1.0.1
CatalogFile = ssm4567.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12

; ================= Class section =====================

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
ssm4567.sys  = 1,,

;*****************************************
; ssm4567  Install Section
;*****************************************

[Manufacturer]
%StdMfg%=Standard,NTAMD64

; Decorated model section take precedence over undecorated
; ones on XP and later.
[Standard.NTAMD64]
%ssm4567.DeviceDesc%=Ssm4567_Device, ACPI\INT343B

[Ssm4567_Device.NT]
CopyFiles=Drivers_Dir

[Ssm4567_Device.NT.HW]
Include=pci.inf
Needs=PciD3ColdSupported.HW

[Drivers_Dir]
ssm4567.sys

;-------------- Service installation
[Ssm4567_Device.NT.Services]
AddService = ssm4567,%SPSVCINST_ASSOCSERVICE%, Ssm4567_Service_Inst

; -------------- ssm4567 driver install sections
[Ssm4567_Service_Inst]
DisplayName    = %ssm4567.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\ssm4567.sys
LoadOrderGroup = Base

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
StdMfg                 = "CoolStar"
DiskId1                = "Analog Devices SSM4567 Installation Disk #1"
ssm4567.DeviceDesc     = "Analog Devices SSM4567 Amplifier"
ssm4567.SVCDESC        = "Analog Devices SSM4567 Service"
